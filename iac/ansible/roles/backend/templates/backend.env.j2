# ==============================================================================
# Variables de Entorno del Backend NestJS (Tenant: {{ tenant_id | default('tenant') }})
# ==============================================================================
PORT=3000
{% if hostvars['db-node'] is defined and hostvars['db-node']['ansible_host'] is defined %}
DATABASE_HOST={{ hostvars['db-node']['ansible_host'] }}
DB_HOST={{ hostvars['db-node']['ansible_host'] }}
{% elif db_private_ip is defined %}
DATABASE_HOST={{ db_private_ip }}
DB_HOST={{ db_private_ip }}
{% else %}
DATABASE_HOST=127.0.0.1
DB_HOST=127.0.0.1
{% endif %}
DATABASE_PORT=5432
DB_PORT=5432
DATABASE_USER=asistencia_app
DB_USERNAME=asistencia_app
DATABASE_PASSWORD={{ tenant_db_password }}
DB_PASSWORD={{ tenant_db_password }}
DATABASE_NAME=asistencia_db
DB_NAME=asistencia_db
DB_SYNCHRONIZE=true
JWT_SECRET={{ tenant_jwt_secret }}
NODE_ENV=production
